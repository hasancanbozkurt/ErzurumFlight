{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=erzurumflight.db"
  },

  "Airport": {
    "Iata": "ERZ",
    "Icao": "LTCE",
    "Timezone": "Europe/Istanbul"
  },

  "Schedule": {
    "FutureDays": 90,
    "RefreshHours": 24
  },

  "FlightTracking": {
    "Enabled": true,
    "PollingSeconds": 30,
    "RadiusNm": 100,
    "RequestsPerSecond": 1,
    "DailyRequestLimit": 500,
    "UseMockProvider": false
  },

  "FlightData": {
    "RapidApiKey": "",
    "SyncIntervalMinutes": 180,
    "WindowHours": 48,
    "RequestsPerSecond": 1
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
